{
  "manifest_version": 3,
  "name": "Where Was I?",
  "version": "0.1.0",
  "description": "Notices when you get distracted and, when you come back, tells you exactly where you left off.",

  "permissions": ["tabs", "storage", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "lib/Readability.js",
        "content/pageReader.js",
        "content/positionTracker.js",
        "content/card.js"
      ],
      "css": ["content/card.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Where Was I?"
  }
}